# ==============================================================================
# 檔案名稱: .env.example
# 責任描述: 列出後端啟動所需之環境變數鍵名與用途說明 (僅鍵名，不含任何真實值)
# 使用方式: 複製為 backend/.env 並填入實際值後，於啟動前載入：
#           set -a && source .env && set +a && ./mvnw spring-boot:run
# 版控邊界: .env 已由 .gitignore 排除；本範本檔可推送遠端
# 注意事項: 選填項目預設以 # 註解；要覆寫時才取消註解並填值。
#           [Why]: 載入「KEY=」空值時，Spring 會使用空字串而不是預設值，數字或布林設定會因此啟動失敗。
# ==============================================================================

# ------------------------------------------------------------------------------
# 必填：資料庫連線 (缺少時應用啟動即失敗)
#   SPRING_DATASOURCE_URL       JDBC 連線字串，例：jdbc:mysql://localhost:3306/survey_flow?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Taipei
#   SPRING_DATASOURCE_USERNAME  資料庫帳號
#   SPRING_DATASOURCE_PASSWORD  資料庫密碼
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# ------------------------------------------------------------------------------
# 必填：JWT 簽章金鑰 (HMAC-SHA256，長度需 >= 32 字元 / 256 bits)
#   產生方式：openssl rand -base64 48
# ------------------------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------------------------
# 必填：稽核日誌 HMAC 金鑰 (至少 32 bytes；需與 JWT_SECRET 不同)
#   產生方式：openssl rand -base64 48
#   正式環境設定後不可更換，否則既有稽核紀錄無法通過完整性驗證
# ------------------------------------------------------------------------------
AUDIT_HMAC_SECRET=

# ------------------------------------------------------------------------------
# 選填：郵件寄送
#   MAIL_PROVIDER   AUTO / BREVO / RESEND / SMTP (預設 AUTO)
#   BREVO_API_KEY   Brevo HTTP API 金鑰 (正式環境主力)
#   RESEND_API_KEY  Resend HTTP API 金鑰 (備用)
#   MAIL_FROM       寄件人信箱 (須為 Brevo 已驗證寄件者)
#   MAIL_USERNAME / MAIL_PASSWORD  SMTP 帳密 (本機備用)
# ------------------------------------------------------------------------------
# MAIL_PROVIDER=
# BREVO_API_KEY=
# RESEND_API_KEY=
# MAIL_FROM=
# MAIL_USERNAME=
# MAIL_PASSWORD=

# ------------------------------------------------------------------------------
# 選填：前端網址與 CORS
#   FRONTEND_BASE_URL     未填時為 http://localhost:4200
#   CORS_ALLOWED_ORIGINS  以其他埠或區網 IP 開發時追加，例：http://localhost:*,http://192.168.*:*
# ------------------------------------------------------------------------------
# FRONTEND_BASE_URL=
# CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 選填：Refresh Token Cookie (正式環境預設 Secure=true、SameSite=None 以支援前後端跨站)
#   本機以 HTTP 開發時請設 REFRESH_COOKIE_SECURE=false 與 REFRESH_COOKIE_SAME_SITE=Lax
# ------------------------------------------------------------------------------
# REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_SAME_SITE=Lax

# ------------------------------------------------------------------------------
# 選填：登入失敗鎖定 (預設連續 5 次失敗鎖定 15 分鐘)
# ------------------------------------------------------------------------------
# LOGIN_MAX_FAILURES=
# LOGIN_LOCK_MINUTES=

# ------------------------------------------------------------------------------
# 選填：全端點速率限制 (每個時間窗、每個 IP 之上限)
#   RATE_LIMIT_WINDOW_SECONDS            時間窗秒數 (預設 60)
#   RATE_LIMIT_AUTH_MAX_REQUESTS         登入註冊等 /api/public/auth/** (預設 20)
#   RATE_LIMIT_SUBMISSION_MAX_REQUESTS   送出問卷 (預設 60)
#   RATE_LIMIT_GENERAL_MAX_REQUESTS      其餘 API (預設 300)
# ------------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_SECONDS=
# RATE_LIMIT_AUTH_MAX_REQUESTS=
# RATE_LIMIT_SUBMISSION_MAX_REQUESTS=
# RATE_LIMIT_GENERAL_MAX_REQUESTS=

# ------------------------------------------------------------------------------
# 選填：可信任反向代理層數 (預設 1，Render 適用)
#   本機直連開發請設 0，否則 X-Forwarded-For 可被任意偽造來繞過速率限制
# ------------------------------------------------------------------------------
TRUSTED_PROXY_COUNT=0

# ------------------------------------------------------------------------------
# 選填：日誌層級 (預設 INFO；本機除錯 SQL 可設 LOG_LEVEL_SQL=DEBUG)
# ------------------------------------------------------------------------------
# LOG_LEVEL_APP=
# LOG_LEVEL_SQL=
